# Target WhatsApp contact or group name (must match search exactly)
TARGET_CONTACT_NAME=Sahil


# Daily send time in 24-hour format (HH:MM)
SEND_TIME=13:33


# Run Chrome without visible window (True/False)
HEADLESS=False

# Persistent Chrome profile directory for WhatsApp session
CHROME_PROFILE_PATH=./chrome_profile

# Selenium explicit wait timeout in seconds
WAIT_TIMEOUT=60

# Number of retry attempts for WhatsApp operations
RETRY_ATTEMPTS=3

# Typing delay range per character (seconds)
TYPE_DELAY_MIN=0.05
TYPE_DELAY_MAX=0.15
